# Slack app credentials (Basic Information → App Credentials)
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# E2B — https://e2b.dev/dashboard
E2B_API_KEY=

# Claude Code auth. Generate with `claude setup-token` (needs a Pro/Max/Team/
# Enterprise plan). Valid one year. Runs bill against the subscription, not
# API credit — which is the whole point of using this instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# Exa MCP — optional. Gives the agent web search tools. Works with no key on
# Exa's free tier; set this to lift the rate limit for production use.
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ElevenLabs — optional. Lets the agent hear Slack voice messages: audio and
# video attachments are transcribed with Scribe v2 (toolkit/skills/voice-notes)
# instead of hitting a Read tool that cannot decode them. Unset simply means
# voice notes come back as "transcription isn't configured".
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# OpenAI Codex CLI — optional. Gives the agent a cross-model second opinion
# (`codex review` / `codex exec`) inside the sandbox. Paste the WHOLE contents of
# your local ~/.codex/auth.json on a single line — it is written straight back
# out to ~/.codex/auth.json in each sandbox, so it must be the file verbatim:
#   jq -c . ~/.codex/auth.json | pbcopy
# Written into a thread's sandbox on its first message only — codex refreshes
# this token in place, so rewriting it each turn would replace a live session's
# credential with this older copy. It expires on roughly a ten-day clock, and a
# thread that outlives that keeps the stale one until it ends.
# Unset simply means no codex in the box; everything else works as before.
CODEX_AUTH_JSON=

# GitHub App — optional. Set all three and the agent can clone, branch, commit,
# push and open PRs with a token minted per request that expires in an hour.
# Leave them empty and the bot works exactly as before, minus GitHub.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# The App's .pem, BASE64-ENCODED on a single line — a raw multiline PEM does not
# survive env var handling. Produce it with:
#   base64 -i your-app.private-key.pem | tr -d '\n' | pbcopy
GITHUB_APP_PRIVATE_KEY=

# Long-term memory — optional. `owner/repo` of a PRIVATE git repo the agent
# pulls before each turn and pushes after it, so what it learns in one Slack
# thread reaches the next one. (A thread's own sandbox is paused and resumed, so
# it already remembers itself; this is what crosses between threads.) Requires
# the GitHub App above to be configured AND installed on this repo — that is the
# only credential the sandbox holds, and without it memory commits locally and
# goes no further than the thread that wrote it.
#
# This is also the kill switch: unset it and redeploy, and memory stops (the
# agent keeps working). See the store's own README for the directory layout.
AGENT_MEMORY_REPO=

# Optional — ceiling on the whole memory sync, ms. Shared across every git step
# in one call, and it runs synchronously in front of the reply, so it needs a
# bound (defaults to 40 seconds).
AGENT_MEMORY_TIMEOUT_MS=40000

# Slack channel reads — optional, and normally needs NOTHING set here.
#
# The sandbox reads other channels by calling back to this deployment
# (/api/sandbox/slack), which holds SLACK_BOT_TOKEN so the sandbox doesn't have
# to. Two values make that work, and both default correctly on Vercel:
#
#   - the public URL, from VERCEL_PROJECT_PRODUCTION_URL (injected automatically)
#   - the signing key, derived from SLACK_SIGNING_SECRET above
#
# Set JOESTAR_PUBLIC_URL when the deployment answers on a custom domain, or when
# developing against a tunnel. Set JOESTAR_PROXY_SECRET to any random string to
# rotate — doing so instantly invalidates every capability already in flight.
JOESTAR_PUBLIC_URL=
JOESTAR_PROXY_SECRET=

# Optional — sandbox template name (defaults to claude-code)
E2B_TEMPLATE=claude-code
# Optional — how long a single Claude run may take, ms (defaults to 10 minutes).
# It doubles as the sandbox's idle deadline: this + 60s. That deadline is only a
# backstop — a thread's sandbox is paused as soon as its turn ends, and reaching
# the deadline pauses it too (never kills it), so the transcript survives either
# way. E2B caps how far out a sandbox timeout may be set, so it can't just be
# raised arbitrarily.
CLAUDE_TIMEOUT_MS=600000
# Optional — override the in-sandbox datastores. The template bakes in Postgres
# and Redis and starts both at boot, so leaving these unset is the normal case;
# set them to point a run at a real database instead.
SANDBOX_DATABASE_URL=
SANDBOX_REDIS_URL=

# Optional — commit identity used inside the sandbox (cosmetic)
GIT_USER_NAME=Joestar
GIT_USER_EMAIL=joestar@users.noreply.github.com
